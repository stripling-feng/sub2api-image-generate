DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sub2api_image_workbench?schema=public"
ENCRYPTION_SECRET="replace-with-at-least-32-random-characters"
UPLOAD_DIR="./uploads"
PORT="3000"
CLIENT_ORIGIN="http://localhost:6655"
# Optional server-side upstream override.
# Defaults to http://127.0.0.1:8080 when NODE_ENV=production, otherwise uses the bound baseUrl.
UPSTREAM_BASE_URL=""
SESSION_DAYS="30"
IMAGE_TASK_POLL_INTERVAL_MS="2000"
IMAGE_TASK_POLL_TIMEOUT_MS="30000"
IMAGE_TASK_MAX_DURATION_MS="1800000"
IMAGE_TASK_LEASE_MS="60000"
SUB2API_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sub2api?schema=public"
GPT_IMAGE_2_UNIT_PRICE_USD="0.5"
# Temporary test switch. Failed GPT-Image-2 jobs are charged after reservation when true.
IMAGE2_CHARGE_ON_FAILURE="false"
# Optional. When empty, billing reuses the latest gpt-image-2 account recorded for the API Key/model.
SUB2API_BILLING_ACCOUNT_ID=""
