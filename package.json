{
  "name": "sub2api-image-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && concurrently \"mvn -f backend/pom.xml spring-boot:run\" \"npm run dev -w client\"",
    "build": "mvn -f backend/pom.xml package && npm run build -w client",
    "test": "mvn -f backend/pom.xml test",
    "typecheck": "npm run typecheck -w client",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:migrate:admin": "node scripts/migrate-admin-data.mjs",
    "db:menus": "node scripts/apply-model-menus.mjs"
  },
  "workspaces": [
    "client"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mysql2": "^3.14.4",
    "pg": "^8.16.3"
  }
}
