GPT_ACCOUNT_STATUS_COOKIE=
# Max parallel ChatGPT account status checks for import and batch refresh.
GPT_ACCOUNT_PARALLELISM=5
UPLOAD_DIR=./uploads
SESSION_DAYS=30
IMAGE2_CHARGE_ON_FAILURE=false
IMAGE_TASK_POLL_INTERVAL_MS=5000
IMAGE_TASK_MAX_DURATION_MS=1800000
IMAGE_CLEANUP_INTERVAL_MS=3600000

# One-time MySQL admin migration only
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=feng-ai-admin
MYSQL_USERNAME=root
MYSQL_PASSWORD=
