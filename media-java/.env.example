MEDIA_DB_USERNAME=root
MEDIA_DB_PASSWORD=
SUB2API_DB_URL=jdbc:postgresql://5.104.85.25:5432/sub2api
SUB2API_DB_USERNAME=root
SUB2API_DB_PASSWORD=
# Only needed once when upgrading databases that contain V19 encrypted GPT tokens.
GPT_ACCOUNT_LEGACY_ENCRYPTION_KEY=
